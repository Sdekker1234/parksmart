{
  "name": "parksmart",
  "version": "0.1.0",
  "private": true,
  "description": "ParkSmart: vergelijk parkeerkosten in Den Bosch met echte RDW-data en AI-advies",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "snapshot": "node scripts/make-snapshot.js",
    "test": "node --test \"server/**/*.test.js\"",
    "build:pages": "node scripts/build-pages.js",
    "live": "node scripts/fetch-live.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "leaflet": "^1.9.4",
    "zod": "^4.6.7"
  }
}
